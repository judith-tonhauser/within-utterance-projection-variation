filter(trueFalse == 1) %>%
filter(utterance == "neg-know-pos-dance") %>%
mutate(utterance = recode(utterance, "neg-know-pos-dance" = "neg-know")) %>%
droplevels() %>%
mutate(content = recode(content, "state.BEL" = "BEL", "state.CC" = "CC")) %>%
rename("qud" = "qudBias") %>%
mutate(qud = recode(qud, "BEL?" = "BEL? QUD", "CC?" = "CC? QUD"))
PL2
